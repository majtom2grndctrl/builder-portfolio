---
// PostHog loads only in production builds, so local dev doesn't pollute analytics.
// The project key is a public, client-side key (it ships to every browser by design).
---

<script>
	const key = import.meta.env.PUBLIC_POSTHOG_KEY;
	const host = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://us.i.posthog.com';

	if (import.meta.env.PROD && key) {
		import('posthog-js').then(({ default: posthog }) => {
			posthog.init(key, {
				api_host: host,
				person_profiles: 'identified_only',
				capture_pageview: 'history_change',
			});
		});
	}
</script>
