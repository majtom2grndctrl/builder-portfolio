		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-is": "^19.3.0",
		"sanity": "^6.17.0",
		"styled-components": "^6.5.3",
		"tailwindcss": "^4.3.3"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
